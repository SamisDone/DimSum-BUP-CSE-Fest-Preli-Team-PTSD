# Copy to .env and fill in. .env is gitignored — never commit real values.
# Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional tuning
# LLM_TIMEOUT_MS=8000        # first model attempt
# LLM_RETRY_TIMEOUT_MS=4000  # second attempt, shorter so the tail stays bounded
# LLM_RETRY_DELAY_MS=300     # pause between the two attempts
# EVAL_DELAY_MS=4500         # pacing for eval-notes.ts against the 15 rpm free tier
PORT=3000
